  "item.riskofrain_items.bustling_fungus.tooltip_1": "After standing still for 2 seconds:",
  "item.riskofrain_items.bustling_fungus.tooltip_2": "Heals for 5% (+2.25% per stack) of",
  "item.riskofrain_items.bustling_fungus.tooltip_3": "the player max health per second",
  "item.riskofrain_items.bustling_fungus.tooltip_total": "Total: %s%% per second (%s in inventory)",

  "item.riskofrain_items.crowbar.tooltip_1": "On hit:",
  "item.riskofrain_items.crowbar.tooltip_2": "Deal 150% (+30% per stack) damage",
  "item.riskofrain_items.crowbar.tooltip_3": "to enemies above 80% health",
  "item.riskofrain_items.crowbar.tooltip_total": "Total: %s%% damage (%s in inventory)",

  "item.riskofrain_items.goat_hoof.tooltip_1": "While sprinting:",
  "item.riskofrain_items.goat_hoof.tooltip_2": "Increases movement speed by 14% (+14% per stack)",
  "item.riskofrain_items.goat_hoof.tooltip_total": "Total: +%s%% movement speed (%s in inventory)",

  "item.riskofrain_items.golden_gun.tooltip_1": "Deal bonus damage depending on how",
  "item.riskofrain_items.golden_gun.tooltip_2": "much gold the player has, up to 40%",
  "item.riskofrain_items.golden_gun.tooltip_3": "damage at 4 stacks of gold ingots",
  "item.riskofrain_items.golden_gun.tooltip_4": "Stacking halves the required gold",
  "item.riskofrain_items.golden_gun.tooltip_total": "Total: +%s%% damage with your gold (%s in inventory)",

  "item.riskofrain_items.infusion.tooltip_1": "On kill:",
  "item.riskofrain_items.infusion.tooltip_2": "Increase max health by 0.5, up to a",
  "item.riskofrain_items.infusion.tooltip_3": "maximum of 10 hearts (+10 hearts per stack)",
  "item.riskofrain_items.infusion.tooltip_total": "Total: up to +%s hearts (%s in inventory)",

  "item.riskofrain_items.lens_makers_glasses.tooltip_1": "On hit:",
  "item.riskofrain_items.lens_makers_glasses.tooltip_2": "6.25% (+6.25% per stack) chance to deal",
  "item.riskofrain_items.lens_makers_glasses.tooltip_3": "double damage, up to a maximum of 100%",
  "item.riskofrain_items.lens_makers_glasses.tooltip_total": "Total: %s%% crit chance (%s in inventory)",

  "item.riskofrain_items.repulsion_armor_plate.tooltip_1": "On being hit:",
  "item.riskofrain_items.repulsion_armor_plate.tooltip_2": "Reduce incoming damage by 1 (+1 per stack)",
  "item.riskofrain_items.repulsion_armor_plate.tooltip_3": "Cannot be reduced below 1",
  "item.riskofrain_items.repulsion_armor_plate.tooltip_total": "Total: -%s damage per hit (%s in inventory)",

  "item.riskofrain_items.rose_buckler.tooltip_1": "While sprinting:",
  "item.riskofrain_items.rose_buckler.tooltip_2": "Reduce incoming damage by 23% (more per stack)",
  "item.riskofrain_items.rose_buckler.tooltip_3": "with diminishing returns",
  "item.riskofrain_items.rose_buckler.tooltip_total": "Total: %s%% damage reduction (%s in inventory)",

  "item.riskofrain_items.smart_shopper.tooltip_1": "On kill:",
  "item.riskofrain_items.smart_shopper.tooltip_2": "4% (+4% per stack) chance",
  "item.riskofrain_items.smart_shopper.tooltip_3": "for enemies to drop gold",
  "item.riskofrain_items.smart_shopper.tooltip_total": "Total: %s%% chance (%s in inventory)",

  "item.riskofrain_items.soldiers_syringe.tooltip_1": "Increases attack speed",
  "item.riskofrain_items.soldiers_syringe.tooltip_2": "+15% attack speed (+15% per stack)",
  "item.riskofrain_items.soldiers_syringe.tooltip_total": "Total: +%s%% attack speed (%s in inventory)",

  "item.riskofrain_items.topaz_brooch.tooltip_1": "On kill:",
  "item.riskofrain_items.topaz_brooch.tooltip_2": "Gain a temporary barrier for 2 hearts",
  "item.riskofrain_items.topaz_brooch.tooltip_3": "(+2 hearts per stack) up to a maximum",
  "item.riskofrain_items.topaz_brooch.tooltip_4": "of the user's max health",
  "item.riskofrain_items.topaz_brooch.tooltip_total": "Total: %s hearts of barrier (%s in inventory)",

  "item.riskofrain_items.tougher_times.tooltip_1": "On being hit:",
  "item.riskofrain_items.tougher_times.tooltip_2": "chance to block incoming damage by:",
  "item.riskofrain_items.tougher_times.tooltip_3": "1 - 1 / (1 + 0.15 * stacked) - 0.01",
  "item.riskofrain_items.tougher_times.tooltip_total": "Total: %s%% chance to block (%s in inventory)",

  "item.riskofrain_items.ukulele.tooltip_1": "...and his music was electric.",

  "text.autoconfig.riskofrain_items.title": "Risk of Rain Items Config",
  "text.autoconfig.riskofrain_items.option.VANILLA_HOSTILE_MOBS_PICK_UP": "Vanilla Hostile Mobs Pick Up Items",
  "text.autoconfig.riskofrain_items.option.VANILLA_HOSTILE_MOBS_PICK_UP.@Tooltip": "Vanilla hostile mobs pick up Risk of Rain items from the ground and gain their passive effects. Carried items drop on death.",
  "text.autoconfig.riskofrain_items.option.PETS_PICK_UP": "Pets Pick Up Items",
  "text.autoconfig.riskofrain_items.option.PETS_PICK_UP.@Tooltip": "Tamed mobs that have an owner, such as wolves, from this mod or others, pick up Risk of Rain items from the ground. This includes horses (also skeleton and zombie horses), camels, cats and parrots. Donkeys, mules and llamas do not pick up: the Risk of Rain items in their chest count instead. Wild wolves use the neutral creatures setting.",
  "text.autoconfig.riskofrain_items.option.MODDED_MOBS_PICK_UP": "Mobs From Other Mods Pick Up Items",
  "text.autoconfig.riskofrain_items.option.MODDED_MOBS_PICK_UP.@Tooltip": "Hostile mobs from other mods, and those listed in the pickup_allowed tag, pick up Risk of Rain items. Mods that handle their own inventories may behave differently.",
  "text.autoconfig.riskofrain_items.option.NEUTRAL_MOBS_PICK_UP": "Neutral Creatures Pick Up Items",
  "text.autoconfig.riskofrain_items.option.NEUTRAL_MOBS_PICK_UP.@Tooltip": "Neutral creatures, such as wild wolves, polar bears and iron golems, pick up Risk of Rain items from the ground. Includes neutral mobs from other mods. Tamed mobs use the pets setting.",
  "text.autoconfig.riskofrain_items.option.CARRIED_SLOTS": "Carried Slots",
  "text.autoconfig.riskofrain_items.option.CARRIED_SLOTS.@Tooltip": "How many different item stacks a mob can carry. Lowering it never removes items a mob already carries.",
  "text.autoconfig.riskofrain_items.option.CARRIERS_NEVER_DESPAWN": "Carriers Never Despawn",
  "text.autoconfig.riskofrain_items.option.CARRIERS_NEVER_DESPAWN.@Tooltip": "A mob carrying at least one item never despawns, so its items are not lost. Turn it off if carriers pile up.",
  "text.autoconfig.riskofrain_items.option.SHOW_CARRIED_ITEMS": "Show Carried Items",
  "text.autoconfig.riskofrain_items.option.SHOW_CARRIED_ITEMS.@Tooltip": "Show the carried items as icons above the mob. Client setting.",
  "text.autoconfig.riskofrain_items.option.DISPLAY_DISTANCE": "Carried Items Display Distance",
  "text.autoconfig.riskofrain_items.option.DISPLAY_DISTANCE.@Tooltip": "Maximum distance in blocks at which the carried item icons are shown.",
  "text.autoconfig.riskofrain_items.option.DISPLAY_MODE": "Carried Items Display Mode",
  "text.autoconfig.riskofrain_items.option.DISPLAY_MODE.ALWAYS": "Always",
  "text.autoconfig.riskofrain_items.option.DISPLAY_MODE.WHEN_LOOKING": "When Looking",
